# Cong server se lang nghe
PORT=8090

# Thong tin ket noi SQL Server (tuong duong db.php)
DB_SERVER=192.168.1.192
DB_NAME=IT_VLH
DB_USER=sa
DB_PASS=P@ssw0rd
DB_ENCRYPT=false

# Thu muc chua file log ACK cua devicecmd (tuong duong devicecmd_log.txt)
LOG_DIR=./logs

# Dong bo gio tu dong: server chu dong gui lenh "SET OPTIONS DateTime=..." moi
# lan may goi /iclock/getrequest (co cooldown, xem TIME_SYNC_INTERVAL_MINUTES),
# de sua tinh trang may cham cong bi lech gio.
TIME_SYNC_ENABLED=true
# Toi da gui lenh dong bo gio 1 lan / X phut cho moi may (tranh spam lenh moi
# vai giay khi may poll lien tuc).
TIME_SYNC_INTERVAL_MINUTES=10
# Bu tru them/bot so phut nay TRUOC KHI gui gio xuong may (co the la so am).
# Dung khi may co firmware quirk: sau khi nhan dung gio that lai tu chay lech
# di vai chuc phut. Vi du da tung thay may nay bi lech ~1 tieng sau khi sync,
# neu gap tinh huong tuong tu thu dat DEVICE_TIME_OFFSET_MINUTES=-60 roi quan
# sat logs/devicecmd_log.txt (Return=0 la may nhan lenh OK) va gio thuc te tren
# man hinh may de tinh chinh dan cho khop.
DEVICE_TIME_OFFSET_MINUTES=0

# Tu dong bu du lieu gan day: server chu dong gui lenh "DATA QUERY ATTLOG" cho
# N ngay gan nhat moi lan may goi /iclock/getrequest (co cooldown per-may, xem
# AUTO_BACKFILL_INTERVAL_MINUTES), de tu "vet" lai du lieu neu server bi mat
# ket noi/down mot luc ma khong can bam tay goi POST /admin/backfill.
AUTO_BACKFILL_ENABLED=false
# So ngay gan nhat se yeu cau may gui lai moi lan tu dong bu.
AUTO_BACKFILL_DAYS=30
# Toi da tu dong bu 1 lan / X phut cho MOI may (mac dinh 1440 = 1 ngay).
# CANH BAO: dat qua ngan se lam may phai doc lai + gui lai TOAN BO log noi bo
# trong AUTO_BACKFILL_DAYS ngay lien tuc, co the la hang chuc nghin dong moi
# lan - du khong tao du lieu trung (da co unique constraint chan) nhung van
# ton bang thong, CPU may cham cong, va hang loat luot INSERT-that-bai tren
# SQL Server neu lap lai qua thuong xuyen. 1440 (1 ngay/lan) la muc an toan,
# ket hop voi viec lan poll dau tien sau moi lan restart server luon duoc bu
# ngay lap tuc (khong doi cooldown) da du de xu ly cac truong hop downtime.
AUTO_BACKFILL_INTERVAL_MINUTES=720

# Tu dong don dep du lieu ATTLOG thang truoc vao ngay X hang thang (xem
# monthlyCleanup.js): backup CSV vao MONTHLY_CLEANUP_BACKUP_DIR, xoa khoi DB,
# va gui lenh yeu cau may cham cong xoa du lieu noi bo (CHUA CHAC CHAN may ho
# tro dung lenh nay - phai test qua POST /admin/cleanup/test-device-command
# truoc, xem README).
MONTHLY_CLEANUP_ENABLED=true
MONTHLY_CLEANUP_DAY=15
MONTHLY_CLEANUP_BACKUP_DIR=./backups
